
<% if notice %>
  <div data-controller="cagagne" >
      <div class="alert alert-info alert-dismissible win-notif fade show m-1" data-cagagne-target="alert" role="alert" data-action="click->cagagne#bob" >
        <%= audio_tag 'success.mp3', id: "win-audio", data: {cagagne_target: "audio"}%>
        <div class="notif-img">
          <%= image_tag ("anxious-octopus.png"), width: 50 %>
        </div>
        <div>
          <%= notice %>
        </div>
          <br>
          <p>Sélectionne une nouvelle <strong>récompense</strong> pour jouer avec ta Tcheam !</p>
      </div>
  </div>
<% end %>
